# Copy to .env for docker compose, then fill in your actual provider details.
# The server also supports mounting ~/.pi/agent/models.json instead; see docker-compose.yml.

VLLM_BASE_URL=https://vllm-api.scch.at/v1
VLLM_MODEL=Qwen/Qwen3.6-27B-FP8 - Reasoning OFF
VLLM_API_KEY=replace-me
PI_MODEL_PROVIDER=llm2go

# Optional tuning
OPENCODE_TIMEOUT_MS=600000
GENERATED_VIEW_TTL_HOURS=168
OPENCODE_VERSION=latest
# OPENCODE_FALLBACK_TEMPLATE=true
