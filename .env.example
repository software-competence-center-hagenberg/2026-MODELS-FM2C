# Copy to .env for docker compose or single-container docker run.

# Valkey (Redis-compatible) queue
VALKEY_URL=redis://valkey:6379

# vLLM provider defaults for SCCH direct docker run deployments
VLLM_BASE_URL=https://vllm-api.scch.at/
VLLM_MODEL='Qwen3.6-27B-FP8 - Reasoning OFF'
VLLM_API_KEY=your-vllm-api-key

# OpenAI-compatible override, if needed
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# opencode tuning
OPENCODE_ENABLED=true
OPENCODE_TIMEOUT_MS=1200000
OPENCODE_VERSION=latest
# OPENCODE_FALLBACK_TEMPLATE=true

# Generated view retention
GENERATED_VIEW_TTL_HOURS=168
