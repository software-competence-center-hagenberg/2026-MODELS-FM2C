# syntax=docker/dockerfile:1

# API container — serves built static frontend + HTTP API
# Lightweight: no opencode needed, but needs full deps for vite build
FROM node:22-bookworm-slim

WORKDIR /app

# Pull Debian security updates for base-image packages (ncurses, perl) so the
# image doesn't ship stale vulnerable libtinfo6/ncurses-base/perl-base from the
# node:22-bookworm-slim bake. zlib1g CVE-2023-45853 is upstream will_not_fix.
# ponytail: single upgrade layer; rebase to -trixie-slim if more CVEs accumulate.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PORT=8787 \
    GENERATED_DATA_DIR=/app/data \
    GENERATED_WORKSPACES_DIR=/app/generated-workspaces \
    GENERATED_DIST_DIR=/app/generated-dist

COPY package.json package-lock.json ./
RUN npm ci --include=dev \
    && npm cache clean --force

COPY . .

RUN npm run build \
    && mkdir -p /app/data /app/generated-workspaces /app/generated-dist \
    && chown -R node:node /app/data /app/generated-workspaces /app/generated-dist

USER node

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 8787) + '/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server/api.js"]
